# RAG Bench Lab - Environment Variables Example
# Copy this file to .env and fill in the actual values

# OpenAI API key (Required for Generation/Phase 2)
OPENAI_API_KEY=your_openai_api_key_here

# HuggingFace Token (Optional, for gated models if needed)
# HF_TOKEN=your_huggingface_token_here

# Cache and Output paths (Optional overrides)
# CACHE_DIR=cache
# OUTPUT_DIR=output
